generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Deal {
  id         String     @id @default(cuid())
  dmdId      String     @unique
  customer   String
  status     String     // Demand | Confirmed | Waiting for Delivery | SUBMITTED | Delivered
  category   String     // B2B | B2G | Internal | Rental
  formFactor String     // Card Only | Custom System | Rack Server | Workstation
  cards      Int        @default(0)
  servers    Int        @default(0)
  revenue    Float      @default(0)
  region     String
  owner      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  shipments  Shipment[]
}

model Shipment {
  id          String    @id @default(cuid())
  dmdId       String?
  deal        Deal?     @relation(fields: [dmdId], references: [dmdId])
  trackingNo  String?
  carrier     String?   // e.g. FedEx
  status      String    // SUBMITTED | IN_TRANSIT | DELIVERED
  origin      String
  destination String
  eta         DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String   // who made the change; defaults to 'system' until auth exists
  action    String   // e.g. CREATE_SHIPMENT | UPDATE_DEAL_STATUS | CREATE_INVOICE
  dealId    String?  // deal id — plain string (not FK) so history survives deletes
  field     String?  // changed field, e.g. 'status'
  oldValue  String?
  newValue  String?
  source    String   // origin of the change, e.g. 'ui' | 'fedex-mock' | 'sheets'
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([dealId])
}
